<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Browsers still request these at the site root
RewriteRule ^favicon\.ico$ assets/favicon.ico [L]
RewriteRule ^apple-touch-icon\.png$ assets/apple-touch-icon.png [L]
RewriteRule ^apple-touch-icon-precomposed\.png$ assets/apple-touch-icon.png [L]

# Redirect /index.html to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect /page.html to /page
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve /page from page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
